# Server-side only environment variables for EmailOctopus integration
EMAIL_OCTOPUS_API_KEY=your_email_octopus_api_key_here
EMAIL_OCTOPUS_LIST_ID=your_email_octopus_list_id_here
CONTACT_EMAIL=builder@example.com

# Client-readable debug toggle for iteration and component labeling (set to true in .env.local for debug overlays)
NEXT_PUBLIC_DEBUG_COMPONENTS=false
